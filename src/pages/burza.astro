---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JPSnakes - Burza" activePage="burza">
    <section class="page-content">
        <h1 class="page-title">Aktuální nabídka / Burza</h1>
        <p class="page-description">Prohlédněte si mláďata a zvířata aktuálně dostupná k prodeji. Osobní předání je možné na vybraných teraristických burzách po ČR (např. Živá Exotika) i v zahraničí (Hamm), případně dle domluvy.</p>
        
        <div class="market-grid">
            <!-- Položka burzy -->
            <div class="market-card">
                <div class="market-image" style="background-image: url('jpsnakes.cz/eastern-hognose-snake-heterodon-platirhinos-11172289.jpg');"></div>
                <div class="market-info">
                    <h3>Heterodon Nasicus - "Arctic"</h3>
                    <div class="market-details">
                        <span><strong>Pohlaví:</strong> 1.0 (Samec)</span>
                        <span><strong>Líhnutí:</strong> Srpen 2025</span>
                        <span><strong>Potrava:</strong> Zcela bezproblémová (rozmrazená)</span>
                    </div>
                    <div class="market-price">3 500 Kč</div>
                    <a href="/kontakt" class="btn-primary">Mám zájem</a>
                </div>
            </div>

            <!-- Položka burzy -->
            <div class="market-card">
                <div class="market-image" style="background-image: url('jpsnakes.cz/corn_snakes1.avif');"></div>
                <div class="market-info">
                    <h3>Corn Snake - "Palmetto"</h3>
                    <div class="market-details">
                        <span><strong>Pohlaví:</strong> 0.1 (Samice)</span>
                        <span><strong>Líhnutí:</strong> Červenec 2025</span>
                        <span><strong>Potrava:</strong> Zcela bezproblémová</span>
                    </div>
                    <div class="market-price">2 800 Kč</div>
                    <a href="/kontakt" class="btn-primary">Mám zájem</a>
                </div>
            </div>
            
            <!-- Položka burzy -->
            <div class="market-card">
                <div class="market-image" style="background-image: url('jpsnakes.cz/Nelsons-Milk-Snake.png');"></div>
                <div class="market-info">
                    <h3>Lampropeltis - "Albino"</h3>
                    <div class="market-details">
                        <span><strong>Pohlaví:</strong> N/A (Neurčeno)</span>
                        <span><strong>Líhnutí:</strong> Srpen 2025</span>
                        <span><strong>Potrava:</strong> Pravidelně přijímá potravu</span>
                    </div>
                    <div class="market-price">1 500 Kč</div>
                    <a href="/kontakt" class="btn-primary">Mám zájem</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
