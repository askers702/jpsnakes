---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JPSnakes - Naše zaměření" activePage="index">
    <section class="snakes-grid">
        <!-- Dlaždice: Corn snakes -->
        <a href="#" class="snake-tile">
            <div class="tile-image" style="background-image: url('jpsnakes.cz/corn_snakes1.avif');"></div>
            <div class="tile-content">
                <h2>Corn snakes</h2>
            </div>
        </a>
        
        <!-- Dlaždice: Heterodons -->
        <a href="#" class="snake-tile">
            <div class="tile-image" style="background-image: url('jpsnakes.cz/eastern-hognose-snake-heterodon-platirhinos-11172289.jpg');"></div>
            <div class="tile-content">
                <h2>Heterodons</h2>
            </div>
        </a>
        
        <!-- Dlaždice: Lampropeltis -->
        <a href="#" class="snake-tile">
            <div class="tile-image" style="background-image: url('jpsnakes.cz/Nelsons-Milk-Snake.png');"></div>
            <div class="tile-content">
                <h2>Lampropeltis</h2>
            </div>
        </a>
        
        <!-- Dlaždice: African house snakes -->
        <a href="#" class="snake-tile">
            <div class="tile-image" style="background-image: url('jpsnakes.cz/sale-arctic-1heterodon.png');"></div>
            <div class="tile-content">
                <h2>African house snakes</h2>
            </div>
        </a>
        
        <!-- Dlaždice: Ball pythons -->
        <a href="#" class="snake-tile">
            <div class="tile-image" style="background-image: url('jpsnakes.cz/normal_ball_python_-_generic.PNG');"></div>
            <div class="tile-content">
                <h2>Ball pythons</h2>
            </div>
        </a>
    </section>
</Layout>
